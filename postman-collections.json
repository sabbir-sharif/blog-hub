                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Michael Brown\",\n  \"email\": \"michael@example.com\",\n  \"password\": \"password123\",\n  \"bio\": \"Java developer and blogger\",\n  \"profileImage\": \"michael.png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
